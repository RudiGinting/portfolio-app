{
  "version": 3,
  "functions": {
    "*.php": {
      "runtime": "vercel-php@0.5.0"
    },
    "admin/*.php": {
      "runtime": "vercel-php@0.5.0"
    }
  },
  "routes": [
    { "src": "^/admin/(.*)$", "dest": "/admin/$1" },
    { "src": "^/(.*\\.php)$", "dest": "/$1" },
    { "src": "^/(.*)$", "dest": "/index.php" }
  ]
}
